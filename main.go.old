type CloudMessage struct {
	Method    string `json:"method"`
	User      string `json:"user,omitempty"`
	ProjectID string `json:"project_id,omitempty"`
	Name      string `json:"name,omitempty"`
	Value     string `json:"value,omitempty"`
}

